FROM oven/bun:1.3.11-alpine

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

EXPOSE 3000

CMD ["sh", "-c", "bun install --frozen-lockfile && bun run db:migrate && if [ \"${PRESENTATION_SEED:-1}\" = 1 ]; then bun run src/db/presentation-seed.ts; fi && exec bun run dev:docker"]
