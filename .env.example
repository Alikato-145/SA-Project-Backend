ELYSIA_PORT=3000
ELYSIA_HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/haris_payroll
NODE_ENV=development
# Generate a unique secret of at least 32 characters; never reuse this example value.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated exact browser origins. Wildcards are rejected.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Optional A1 defaults shown explicitly for operators.
AUTH_SESSION_TTL_SECONDS=28800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_SECONDS=900
