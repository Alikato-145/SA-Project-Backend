{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "test:person-a:db": "sh scripts/test-person-a-db.sh",
    "dev": "bun run --watch src/index.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --ignore \"src/**/*.test.ts\" --ext ts --exec \"bun run src/index.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "bun run scripts/migrate-production.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:release": "bun run src/db/release-fixture.ts",
    "test:db": "bun run scripts/test-database.ts",
    "db:up": "docker compose -f ../compose.yaml up -d --wait postgres",
    "db:down": "docker compose -f ../compose.yaml stop postgres",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/jwt": "^1.4.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "jose": "^6.0.11",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.4",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.2"
  },
  "module": "src/index.js"
}
