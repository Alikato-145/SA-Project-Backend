{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --ext ts --exec \"bun run src/index.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts",
    "db:up": "docker compose -f ../compose.yaml up -d --wait postgres",
    "db:down": "docker compose -f ../compose.yaml stop postgres",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/jwt": "^1.4.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "elysia": "latest",
    "pg": "^8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.4",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.2"
  },
  "module": "src/index.js"
}
